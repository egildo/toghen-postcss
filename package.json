{
  "name": "@toghen/postcss",
  "version": "0.1.0",
  "description": "PostCSS plugin for resolving Toghen design tokens in CSS",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external @toghen/lib --external postcss",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "dev": "tsup src/index.ts --format esm --watch",
    "test": "node --import tsx/esm --test 'test/**/*.test.ts'",
    "prepare": "pnpm run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check . && pnpm typecheck && pnpm test && pnpm build && node scripts/check-purity.mjs"
  },
  "keywords": [
    "postcss-plugin",
    "design-tokens",
    "toghen",
    "css"
  ],
  "author": "Egildo Tagliareni <egildo@tagliareni.it>",
  "license": "MIT",
  "peerDependencies": {
    "postcss": "^8.0.0",
    "@toghen/lib": "^0.1.0"
  },
  "dependencies": {
    "mdn-data": "^2.37.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@csstools/postcss-mixins": "1.1.0",
    "@toghen/lib": "^0.1.0",
    "@types/node": "^24.1.0",
    "postcss": "^8.5.6",
    "postcss-custom-media": "12.0.3",
    "postcss-custom-selectors": "9.0.4",
    "tsup": "^8.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/Toghen/postcss.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.29.3"
}
